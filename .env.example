# Beispiel-Environment-Variablen für gym-workload-forecasting.
# Kopiere nach `.env` und fülle die Werte ein. `.env` ist gitignored.

# Lokale Postgres
SCRAPER_LOCAL_DB__HOST=
SCRAPER_LOCAL_DB__PORT=5432
SCRAPER_LOCAL_DB__NAME=
SCRAPER_LOCAL_DB__USER=
SCRAPER_LOCAL_DB__PASSWORD=

# Supabase
SCRAPER_SUPABASE_DB__HOST=
SCRAPER_SUPABASE_DB__PORT=5432
SCRAPER_SUPABASE_DB__NAME=
SCRAPER_SUPABASE_DB__USER=
SCRAPER_SUPABASE_DB__PASSWORD=
SCRAPER_SUPABASE_DB__SSLMODE=require

# Aidoo-Mandant (Studio-Gruppen-Identifikator)
SCRAPER_MANDANT=
